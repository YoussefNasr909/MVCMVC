@model IEnumerable<Course>
@{
    ViewData["Title"] = "Manage Courses";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Manage Courses</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><i class="fas fa-book me-2"></i>Courses</h3>
                <a asp-action="CreateCourse" class="btn btn-success">
                    <i class="fas fa-plus-circle me-1"></i> Add New Course
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Credit Hours</th>
                                <th>Department</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>@course.Code</td>
                                    <td>@course.Name</td>
                                    <td>@course.CreditHours</td>
                                    <td>@(course.Department?.Name ?? "Not Assigned")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-primary btn-sm">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');" style="display: inline;">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>