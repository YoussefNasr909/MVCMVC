@model IEnumerable<ANU.Models.Faculty>
@{
    ViewData["Title"] = "Manage Faculties";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Manage Faculties</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Faculties List</h2>
            <a asp-action="CreateFaculty" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Faculty
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Programs</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                            <td>@item.Programs.Count</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditFaculty" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="DeleteFaculty" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>