@model ANU.Models.Staff
@{
    ViewData["Title"] = "Delete Staff";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Delete Staff</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h3 class="card-title mb-0">Confirm Delete</h3>
                    </div>
                    <div class="card-body">
                        <h4>Are you sure you want to delete this staff member?</h4>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> This action cannot be undone.
                        </div>

                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "/css/anu/staff1.jpg" : Model.ProfileImageUrl)"
                                             class="img-fluid rounded" alt="@Model.FullName" />
                                    </div>
                                    <div class="col-md-8">
                                        <h5 class="card-title">@Model.FullName</h5>
                                        <p class="card-text"><strong>Title:</strong> @Model.Title</p>
                                        <p class="card-text"><strong>Department:</strong> @Model.Department</p>
                                        <p class="card-text"><strong>Faculty:</strong> @Model.Faculty</p>
                                        <p class="card-text"><strong>Email:</strong> @Model.Email</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <form asp-action="DeleteStaff" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-action="ManageStaff" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>