@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Admin Dashboard</h1>";
}

<section class="about-us">
    <div class="admin-dashboard">
        <div class="alert alert-success mb-4">
            <h2 class="mb-0"><i class="fas fa-user-shield me-2"></i>Welcome, @ViewBag.AdminName</h2>
        </div>

        <div class="dashboard-stats">
            <div class="stat-card">
                <h3><i class="fas fa-user-graduate me-2"></i>Students</h3>
                <p class="stat-number">@ViewBag.StudentCount</p>
                <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-primary">Manage</a>
            </div>

            <div class="stat-card">
                <h3><i class="fas fa-university me-2"></i>Faculty</h3>
                <p class="stat-number">@ViewBag.FacultyCount</p>
                <a asp-controller="Admin" asp-action="ManageFaculties" class="btn btn-primary">Manage</a>
            </div>

            <div class="stat-card">
                <h3><i class="fas fa-book me-2"></i>Courses</h3>
                <p class="stat-number">@ViewBag.CourseCount</p>
                <a asp-controller="Admin" asp-action="ManageCourses" class="btn btn-primary">Manage</a>
            </div>

            <div class="stat-card">
                <h3><i class="fas fa-chalkboard-teacher me-2"></i>Staff</h3>
                <p class="stat-number">@ViewBag.StaffCount</p>
                <a asp-controller="Admin" asp-action="ManageStaff" class="btn btn-primary">Manage</a>
            </div>
        </div>

        <div class="dashboard-actions">
            <h2>Quick Actions</h2>
            <div class="action-grid">
                <a asp-controller="Admin" asp-action="ManageUsers" class="action-card">
                    <i class="fas fa-users"></i>
                    <span>Manage Users</span>
                </a>

                <a asp-controller="Admin" asp-action="ManageFaculties" class="action-card">
                    <i class="fas fa-university"></i>
                    <span>Manage Faculties</span>
                </a>

                <a asp-controller="Admin" asp-action="ManageDepartments" class="action-card">
                    <i class="fas fa-building"></i>
                    <span>Manage Departments</span>
                </a>

                <a asp-controller="Admin" asp-action="ManageStaff" class="action-card">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <span>Manage Staff</span>
                </a>

                <a asp-controller="Admin" asp-action="ManageNews" class="action-card">
                    <i class="fas fa-newspaper"></i>
                    <span>Manage News</span>
                </a>
            </div>
        </div>
    </div>
</section>