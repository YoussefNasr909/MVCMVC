@model Department
@{
    ViewData["Title"] = "Delete Department";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Delete Department</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h3 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Delete Department</h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <h4>Are you sure you want to delete this department?</h4>
                            <p>This action cannot be undone and may affect courses and users associated with this department.</p>
                        </div>

                        <div class="department-details mb-4">
                            <h5>Department Details</h5>
                            <dl class="row">
                                <dt class="col-sm-3">Name</dt>
                                <dd class="col-sm-9">@Model.Name</dd>

                                <dt class="col-sm-3">Description</dt>
                                <dd class="col-sm-9">@Model.Description</dd>

                                <dt class="col-sm-3">Faculty</dt>
                                <dd class="col-sm-9">@(Model.Faculty?.Name ?? "Not Assigned")</dd>
                            </dl>
                        </div>

                        <form asp-action="DeleteDepartment" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="form-group d-flex justify-content-between">
                                <a asp-action="ManageDepartments" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete Department</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>