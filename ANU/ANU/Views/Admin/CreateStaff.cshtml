@model ANU.Models.Staff
@{
    ViewData["Title"] = "Create Staff";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Create Staff</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">Add New Staff Member</h3>
                    </div>
                    <div class="card-body">
                        <form asp-action="CreateStaff" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label">Full Name</label>
                                    <input asp-for="FullName" class="form-control" required />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Title" class="form-label">Title</label>
                                    <input asp-for="Title" class="form-control" required />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Faculty" class="form-label">Faculty</label>
                                    <input asp-for="Faculty" class="form-control" required />
                                    <span asp-validation-for="Faculty" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Department" class="form-label">Department</label>
                                    <input asp-for="Department" class="form-control" required />
                                    <span asp-validation-for="Department" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" required />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Office" class="form-label">Office</label>
                                    <input asp-for="Office" class="form-control" />
                                    <span asp-validation-for="Office" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OfficeHours" class="form-label">Office Hours</label>
                                <input asp-for="OfficeHours" class="form-control" />
                                <span asp-validation-for="OfficeHours" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Education" class="form-label">Education</label>
                                <textarea asp-for="Education" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Education" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ProfileImageUrl" class="form-label">Profile Image URL</label>
                                <input asp-for="ProfileImageUrl" class="form-control" />
                                <span asp-validation-for="ProfileImageUrl" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a asp-action="ManageStaff" class="btn btn-secondary">Back to List</a>
                                <button type="submit" class="btn btn-primary">Create</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}