@model User
@{
    ViewData["Title"] = "Delete User";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Delete User</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h3 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Delete User</h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <h4>Are you sure you want to delete this user?</h4>
                            <p>This action cannot be undone.</p>
                        </div>

                        <div class="user-details mb-4">
                            <h5>User Details</h5>
                            <dl class="row">
                                <dt class="col-sm-3">Name</dt>
                                <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                                <dt class="col-sm-3">Email</dt>
                                <dd class="col-sm-9">@Model.Email</dd>

                                <dt class="col-sm-3">Role</dt>
                                <dd class="col-sm-9">@Model.Role</dd>

                                <dt class="col-sm-3">Faculty</dt>
                                <dd class="col-sm-9">@(Model.Faculty?.Name ?? "Not Assigned")</dd>

                                <dt class="col-sm-3">Department</dt>
                                <dd class="col-sm-9">@(Model.Department?.Name ?? "Not Assigned")</dd>

                                @if (!string.IsNullOrEmpty(Model.StudentId))
                                {
                                    <dt class="col-sm-3">Student ID</dt>
                                    <dd class="col-sm-9">@Model.StudentId</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.StaffId))
                                {
                                    <dt class="col-sm-3">Staff ID</dt>
                                    <dd class="col-sm-9">@Model.StaffId</dd>
                                }
                            </dl>
                        </div>

                        <form asp-action="DeleteUser" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="form-group d-flex justify-content-between">
                                <a asp-action="ManageUsers" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete User</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>