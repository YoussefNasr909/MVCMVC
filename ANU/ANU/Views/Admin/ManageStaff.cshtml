@model IEnumerable<ANU.Models.Staff>
@{
    ViewData["Title"] = "Manage Staff";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Manage Staff</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Staff List</h2>
            <a asp-action="CreateStaff" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Staff
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Faculty</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FullName</td>
                            <td>@item.Title</td>
                            <td>@item.Department</td>
                            <td>@item.Faculty</td>
                            <td>@item.Email</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditStaff" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="DeleteStaff" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>