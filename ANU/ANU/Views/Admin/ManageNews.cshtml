@model IEnumerable<NewsItem>
@{
    ViewData["Title"] = "Manage News";
    ViewData["HeaderClass"] = "sub-header";
    ViewData["HeaderContent"] = "<h1>Manage News</h1>";
}

<section class="about-us">
    <div class="container">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><i class="fas fa-newspaper me-2"></i>News</h3>
                <a asp-action="CreateNews" class="btn btn-success">
                    <i class="fas fa-plus-circle me-1"></i> Add News Item
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Published Date</th>
                                <th>Author</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var news in Model)
                            {
                                <tr>
                                    <td>@news.Title</td>
                                    <td>@news.PublishedDate.ToString("MMM dd, yyyy")</td>
                                    <td>@news.Author</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="EditNews" asp-route-id="@news.Id" class="btn btn-primary btn-sm">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-action="DeleteNews" asp-route-id="@news.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this news item?');" style="display: inline;">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>